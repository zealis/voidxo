    {
      "id": "client-data-cache",
      "name": "客户端数据缓存与后台刷新能力",
      "note": "客户端获取的数据必须提供统一缓存与后台刷新能力（SvelteKit load + SWR 语义），显式定义缓存键、TTL、失效、重试与去重；公开与私有数据使用不同策略，私有数据不进入公共缓存，缓存内容可从权威数据源重建。",
      "origin": "local",
      "strength": "required",
      "applicability": "applicable",
      "scope": "modules",
      "modules": [
        "web-app",
        "ui-system",
        "delivery"
