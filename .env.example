VOIDXO_ENV=development
VOIDXO_HTTP_ADDR=127.0.0.1:8080
VOIDXO_DATABASE_DSN=voidxo:change-me@tcp(127.0.0.1:13306)/voidxo?charset=utf8mb4&parseTime=true&loc=Local
VOIDXO_REDIS_ADDR=127.0.0.1:6379
VOIDXO_REDIS_PASSWORD=
VOIDXO_REDIS_DB=0
VOIDXO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VOIDXO_TRUSTED_PROXIES=127.0.0.1/32,::1/128
VOIDXO_SESSION_IDLE_TTL=168h
VOIDXO_SESSION_ABSOLUTE_TTL=720h
VOIDXO_COOKIE_SECURE=false
VOIDXO_SHUTDOWN_TIMEOUT=10s

# SvelteKit 开发服务器代理目标；不是浏览器公开配置。
API_ORIGIN=http://127.0.0.1:8080

# 创建首个账号时不写入文件，在 shell 中临时设置：
# VOIDXO_BOOTSTRAP_PASSWORD='replace-with-a-long-local-password'

# 图片存储目录与访问前缀（生产可替换为 S3/R2 实现）
VOIDXO_UPLOAD_DIR=./uploads
VOIDXO_MEDIA_BASE_URL=/media

# 页面缓存失效：Worker 处理后端事件后通知 SvelteKit 清空公开页缓存。
# 留空表示不启用（前端未配置 REVALIDATE_TOKEN 时端点等同于不存在）。
VOIDXO_WEB_REVALIDATE_URL=http://127.0.0.1:5173/internal/revalidate
VOIDXO_WEB_REVALIDATE_TOKEN=

# 邮件发送：留空时 Worker 使用日志发送器（仅本地开发）。
# mode 可选 starttls（默认）、tls、none。
VOIDXO_SMTP_HOST=
VOIDXO_SMTP_PORT=587
VOIDXO_SMTP_USERNAME=
VOIDXO_SMTP_PASSWORD=
VOIDXO_SMTP_FROM=
VOIDXO_SMTP_FROM_NAME=VOIDXO
VOIDXO_SMTP_MODE=starttls

# 参与邮箱验证码哈希的服务器密钥，生产必须设置为随机长字符串。
VOIDXO_EMAIL_CODE_PEPPER=
